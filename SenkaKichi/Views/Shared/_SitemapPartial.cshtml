@{
    var Servers = SenkaKichi.Models.SenkaRepository.Servers;
    string ActionName = ViewContext.RouteData.Values["action"].ToString().ToLower();
    string Title1 = "サーバ", Title2 = "情報";
    if (ViewBag.ServerId == 0) {
        Title1 = "全サーバ";
    } else if (ViewBag.ServerId != null) {
        Title1 = Servers[ViewBag.ServerId].Name;
    }
    if (ActionName.StartsWith("ranking")) {
        Title2 = "ランキング";
    } else if (ViewBag.Player != null) {
        Title2 = ViewBag.Player.Name;
    }
}

<ul class="nav navbar-nav pull-left">
    <li class="dropdown dropdown-style pull-left">
        <a href="#" class="dropdown-toggle text-center" data-toggle="dropdown" role="button" aria-expanded="false">@Title1<span class="caret"></span></a>
        <ul class="dropdown-menu" role="menu">
            @if (ViewBag.ServerId == 0) {
                <li class="active">@Html.ActionLink("全サーバ", "Info", "Server", new { id = 0 }, null)</li>
            } else {
                <li>@Html.ActionLink("全サーバ", "Info", "Server", new { id = 0 }, null)</li>
            }
            <li class="divider"></li>
            @foreach (var server in Servers.Values) {
                if (ViewBag.ServerId == server.ServerId) {
                    <li class="active">@Html.ActionLink(server.Name, "Info", "Server", new { id = server.ServerId }, null)</li>
                } else {
                    <li>@Html.ActionLink(server.Name, "Info", "Server", new { id = server.ServerId }, null)</li>
                }
            }
        </ul>
    </li>
    
    @if (ViewBag.ServerId != null) {
    <li class="dropdown dropdown-style pull-left">
        <a href="#" class="dropdown-toggle text-center" data-toggle="dropdown" role="button" aria-expanded="false">@Title2<span class="caret"></span></a>
        <ul class="dropdown-menu" role="menu">
            @if (ViewBag.Player != null) {
                if (ActionName == "info") {
                    <li class="active">@Html.ActionLink("情報", "Info", "Player", new { id = ViewBag.Player.PlayerId }, null)</li>
                    <li>@Html.ActionLink("アクティビティ", "Activity", "Player", new { id = ViewBag.Player.PlayerId }, null)</li>
                } else if (ActionName == "activity") {
                    <li>@Html.ActionLink("情報", "Info", "Player", new { id = ViewBag.Player.PlayerId }, null)</li>
                    <li class="active">@Html.ActionLink("アクティビティ", "Activity", "Player", new { id = ViewBag.Player.PlayerId }, null)</li>
                }
                <li class="divider"></li>
            }
            @if (ActionName.StartsWith("info") && ViewBag.Player == null) {
                <li class="active">@Html.ActionLink("サーバ情報", "Info", "Server", new { id = ViewBag.ServerId }, null)</li>
            } else {
                <li>@Html.ActionLink("サーバ情報", "Info", "Server", new { id = ViewBag.ServerId }, null)</li>
            }
            @if (ActionName.StartsWith("ranking")) {
                <li class="active">@Html.ActionLink("ランキング", "Ranking", "Server", new { id = ViewBag.ServerId }, null)</li>
            } else {
                <li>@Html.ActionLink("ランキング", "Ranking", "Server", new { id = ViewBag.ServerId }, null)</li>
            }
        </ul>
    </li>
    }
</ul>