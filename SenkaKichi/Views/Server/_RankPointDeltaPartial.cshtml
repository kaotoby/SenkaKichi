@model SenkaData
@if (Model.RankPointDelta.HasValue) {
    int value = Model.RankPointDeltaExact.Value;
    if (value < 50) {
        <span class="cl-gray">(+@value)</span>
    } else if (value < 100) {
        <span class="cl-green">(+@value)</span>
    } else if (value < 150) {
        <span class="cl-blue">(+@value)</span>
    } else {
        <span class="cl-blue font-bold">(+@value)</span>
    }
}
@if (Model.RankPointDeltaExtra > 0) {
    <span class="cl-red"><small>(+@Model.RankPointDeltaExtra.Value)</small></span>
}