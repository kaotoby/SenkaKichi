@model SenkaKichi.DbModels.AspNetUser
@if (Model != null) {
    <li class="dropdown pull-right">
        @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "logout" })) {
            @Html.AntiForgeryToken()
        }
        <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-expanded="false">
            <span class="hidden-xs">@Model.UserName</span>
            <img src="@Model.TwitterInfo.AvatarUrl" id="avatar" alt="Avatar" width="32" />
        </a>
        <ul class="dropdown-menu dropdown-menu-style" role="menu">
            <li>@Html.ActionLink("Manage", "Index", "Manage")</li>
            <li><a href="#">Another action</a></li>
            <li><a href="#">Something else here</a></li>
            <li class="divider"></li>
            <li><a href="javascript:$('#logout').submit()">ログアウト</a></li>
        </ul>
    </li>
} else {
    <li class="pull-right">
        @using (Html.BeginForm("ExternalLogin", "Account", FormMethod.Post, new { id = "login" })) {
            @Html.AntiForgeryToken()
            @Html.Hidden("provider", "Twitter")
            @Html.Hidden("returnUrl", Request.RawUrl)
        }
        <a href="javascript:$('#login').submit()">
            <span class="hidden-xs">Twitterで</span>ログイン
            <img alt="Twitter Bird" src="data:image/png;base64," />
        </a>
    </li>
}
