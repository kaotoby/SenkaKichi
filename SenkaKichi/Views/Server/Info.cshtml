@model SenkaKichi.ViewModels.Server.InfoViewModel
@{
    ViewBag.Title = Model.Server.Name;
    ViewBag.Description = string.Format("艦これ「{0}」サーバの最新の戦果情報です。", Model.Server.Name);
    ViewBag.Keywords = string.Format(",{0}", Model.Server.Name);
    ViewBag.ServerId = Model.Server.ServerId;
}
<header class="page-header row">
    <div class="col-lg-8 col-md-7">
        <h1>@Model.Server.Name <br class="hidden-lg" /><small>@Model.DateInfo</small></h1>
    </div>
</header>

<section id="charts">
    <div id="RankPointDeltaChart"></div><br />
    <div id="RankPointChart"></div>
</section>

@section Scripts{
    <script>var SenkaChart = @Html.Raw(Model.JsonChart);</script>
    @Scripts.Render("~/bundles/highcharts")
    @Scripts.Render("~/bundles/models/server")
}