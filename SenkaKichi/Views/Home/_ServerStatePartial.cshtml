<nav class="list-group">
    <a class="list-group-item active" href="@Url.Action("Ranking", "Server", new { id = 0 })">
        全サーバ
    </a>
    @foreach (var server in SenkaKichi.Models.SenkaRepository.Servers.Values) {
        <a class="list-group-item" href="@Url.Action("Ranking", "Server", new { id = server.ServerId })">
            @*@if (DateTime.Now.AddHours(-12) < server.DateInfo.Date) {
                <span class="badge">新</span>
            }*@
            @server.Name
        </a>
    }
</nav>